# Docker Compose settings. Copy to .env (never commit it) and replace every change-me value.
# Use URL-safe characters in passwords: they are embedded in DATABASE_URL.

# Backend runtime environment: local | test | staging | production.
APP_ENV=local
# Backend log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Key for hashing user identifiers in backend logs. At least 32 chars: openssl rand -hex 32
LOG_HASH_SECRET=change-me
# Job sources: contact for the backend's User-Agent, and optional Adzuna API credentials.
SOURCES_CONTACT=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Versions of the terms of use and privacy policy accepted at registration.
LEGAL_TERMS_VERSION=2026-09-draft
LEGAL_PRIVACY_VERSION=2026-09-draft

# Application database (postgres service).
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ai_job_assistant

# n8n's own database (n8n-db service). n8n never gets the application database credentials.
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change-me
N8N_DB_NAME=n8n
# Encrypts credentials stored in n8n. Generate with: openssl rand -hex 32. Never change it after first start.
N8N_ENCRYPTION_KEY=change-me

# Caddy site address. http://localhost for local; a domain (e.g. app.example.com) enables automatic HTTPS.
SITE_ADDRESS=http://localhost

# Optional host port overrides (published on 127.0.0.1 only, except Caddy).
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# MAILPIT_UI_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# N8N_HOST_PORT=5678
# CADDY_HTTP_PORT=80
# CADDY_HTTPS_PORT=443
