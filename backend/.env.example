# Backend settings, read by app/core/config.py. Copy to backend/.env for host-run development.
# In Docker Compose these values are set by docker-compose.yml from the root .env.

# Runtime environment: local | test | staging | production. API docs are served only in local/test.
APP_ENV=local
# Log level: DEBUG | INFO | WARNING | ERROR.
LOG_LEVEL=INFO
# Log output: json (one JSON object per line; default, used in containers) | console (readable, local).
LOG_FORMAT=console
# Required. Key for hashing user identifiers in logs (TD-21). At least 32 chars: openssl rand -hex 32
LOG_HASH_SECRET=change-me-to-32-or-more-random-characters

# Application database (async driver required). Matches the Compose postgres service published on localhost.
DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/ai_job_assistant
# SQLAlchemy connection pool size per process.
DATABASE_POOL_SIZE=5

# Redis for rate limits and short-lived caches only.
REDIS_URL=redis://localhost:6379/0

# Maximum request body size in bytes; larger requests get 413 PAYLOAD_TOO_LARGE.
MAX_REQUEST_BODY_BYTES=65536

# Per-dependency timeout for GET /api/v1/ready, in seconds.
READINESS_TIMEOUT_SECONDS=2.0

# Job sources (docs/source-compliance.md). Contact shown in our honest User-Agent
# ("AIJobAssistant/0.1 (+contact)"); required before any real source runs.
SOURCES_CONTACT=
# Timeout for one request to a source, in seconds.
SOURCE_HTTP_TIMEOUT_SECONDS=10
# Adzuna API credentials from https://developer.adzuna.com (source "adzuna"). Leave empty
# to keep the adapter unconfigured. The key is a secret: never commit it.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Per-source API limits (separate from user limits): longest wait for a rate-limit token,
# automatic attempts per source in one run, delay between them, and when a claimed source run
# may be taken over by another worker.
SOURCE_RATE_LIMIT_MAX_WAIT_SECONDS=5
SOURCE_RUN_MAX_ATTEMPTS=2
SOURCE_RETRY_DELAY_SECONDS=1
SOURCE_RUN_LEASE_SECONDS=60

# Search runs (TD-12): dispatcher, run deadline, and per-user limits.
# inline = run in this process (dev, tests, fallback); n8n = signed trigger to WF-001 (TD-09),
# which needs the four n8n settings below.
JOB_DISPATCHER=inline
SEARCH_JOB_DEADLINE_SECONDS=120
SEARCH_MAX_ACTIVE_JOBS_PER_USER=2
SEARCH_MAX_RUNS_PER_HOUR=20
SEARCH_MAX_RESULTS_PER_JOB=200

# AI calls (TD-07). No provider is configured yet (product-owner decision); these bound any
# provider: per-call timeout, retries on 429/5xx, circuit breaker (failures in a row, pause),
# and per-user quotas.
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=1
AI_RETRY_DELAY_SECONDS=1
AI_CIRCUIT_FAILURE_THRESHOLD=5
AI_CIRCUIT_OPEN_SECONDS=60
AI_MAX_CALLS_PER_MINUTE=10
AI_MAX_CALLS_PER_DAY=50

# n8n (TD-06, architecture §8.3). One secret per direction, each at least 32 chars and all
# different: openssl rand -hex 32. Secrets: never commit them.
# backend -> n8n: WF-001 webhook and the secret that signs its trigger.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=
N8N_WEBHOOK_TIMEOUT_SECONDS=5
# n8n -> backend: bearer token and HMAC secret for /internal/v1. Unset = internal API refuses all.
INTERNAL_API_TOKEN=
INTERNAL_HMAC_SECRET=
# Accepted clock difference for signed requests (replay window), in seconds.
INTERNAL_SIGNATURE_MAX_AGE_SECONDS=300

# Redis for Redis-backed tests (rate limiter); leave unset to skip them. Use a spare DB number.
TEST_REDIS_URL=redis://localhost:6379/15

# Required. Versions of the terms of use and privacy policy a user accepts at registration.
LEGAL_TERMS_VERSION=2026-09-draft
LEGAL_PRIVACY_VERSION=2026-09-draft

# Session cookies (TD-03). Must be true in staging/production; browsers accept Secure cookies on
# http://localhost, so keep it true locally too unless you use another host name over plain http.
SESSION_COOKIE_SECURE=true
# Session lifetimes, in seconds or ISO 8601 durations: idle, with "remember me", without it.
SESSION_IDLE_TIMEOUT=P7D
SESSION_ABSOLUTE_TIMEOUT=P30D
SESSION_BROWSER_TIMEOUT=PT12H
# How often an active session's last_seen_at is written (limits write load).
SESSION_TOUCH_INTERVAL=PT5M

# Argon2id cost (TD-04): tune so one hash takes ~100-250 ms on production hardware.
PASSWORD_HASH_TIME_COST=2
PASSWORD_HASH_MEMORY_KIB=19456
PASSWORD_HASH_PARALLELISM=1

# Brute-force protection (AUTH-006): failed logins in a row that lock an account, and for how long.
LOGIN_LOCKOUT_THRESHOLD=10
LOGIN_LOCKOUT_DURATION=PT15M
# Lifetime of the single-use link in a password reset email.
PASSWORD_RESET_TOKEN_TTL=PT30M

# Proxies in front of the backend that append to X-Forwarded-For (for the client IP in rate limits).
# 0 when the backend is called directly (host-run development); Compose sets 1 (Caddy).
TRUSTED_PROXY_COUNT=0

# Public origin of the web app, used in links inside emails. Must be https in staging/production.
APP_PUBLIC_URL=http://localhost:3000
# Outgoing email (TD-27). Defaults match Mailpit published on the host (UI: http://127.0.0.1:8025).
# Staging/production need a real SMTP host and SMTP_SECURITY starttls or tls.
SMTP_HOST=localhost
SMTP_PORT=1025
# none | starttls | tls
SMTP_SECURITY=none
SMTP_USERNAME=
# Secret: never commit it.
SMTP_PASSWORD=
SMTP_TIMEOUT_SECONDS=10
EMAIL_FROM=AI Job Assistant <no-reply@localhost>

# Database for integration tests. It is wiped and rebuilt from migrations on every test run.
# Leave unset to skip database tests. The Compose postgres creates <POSTGRES_DB>_test on first start.
TEST_DATABASE_URL=postgresql+asyncpg://app:change-me@localhost:5432/ai_job_assistant_test
